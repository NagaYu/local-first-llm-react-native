# Do not auto-install peer dependencies. `react-native` and (optionally)
# `react-native-executorch` are peers provided by the consuming app, not by this
# library's own toolchain — the source has no top-level `react-native` import and
# the executorch backend loads its peer lazily. Keeping them out of the dev
# install proves the cloud-only path works without them and keeps CI lean.
auto-install-peers=false
